# SQLite (default). Postgres ke liye:
# DATABASE_URL=postgresql://user:password@localhost:5432/subjudice
DATABASE_URL=sqlite:///./subjudice.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
MAX_FILES_PER_CASE=20
# Comma-separated; "*" = allow every type
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tif,tiff,webp,txt,csv,doc,docx,xls,xlsx,mp3,wav,mp4,mov,eml,json
# Routing thresholds (0..1). Dono me se koi bhi cross hua to DIRECT_TO_COURT
URGENCY_THRESHOLD=0.7
COMPLEXITY_THRESHOLD=0.7
# Deadline itne din (ya kam) door ho / nikal chuki ho => seedha court (AI + student + senior review time pe poora nahi ho sakta)
DEADLINE_URGENT_DAYS=7
# IMPORTANT: production me zaroor set karo. Khali = dev mode (sab open).
# Set hone par X-Staff-Token header zaroori hai: POST /cases/{id}/override, POST /custody,
# POST/PATCH /hearings, POST /hearings/{id}/drafts. Reads open hain, lekin case_officer ka naam /custody me "[restricted]" dikhta hai.
STAFF_TOKEN=
CORS_ORIGINS=*

# ---- v0.3 ----
# Per-person staff tokens (recorded by name in the audit log). Use this instead of the single STAFF_TOKEN:
# STAFF_TOKENS=asha:long-random-1,ravi:long-random-2
# Reads need a staff token or the case's X-Case-Token whenever a staff token exists. 0 = leave reads open.
PROTECT_READS=
# Set to your frontend origin in production, e.g. https://sub-judice.example.org (NOT "*")
# Optional AI scorer (Ollama). Blank = rules only. The model can only RAISE urgency/complexity, never lower it.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=8
# HMAC key for /custody/anchor signatures (defaults to a staff token)
ANCHOR_SECRET=

# ---- Sources & judgments ----
# Token for the AI intake service (sent as X-AI-Token) so it can file cases with source=ai and add evidence.
AI_TOKEN=
# Plain-language drafting of judgments uses OLLAMA_URL above. Judgments longer than this many characters are
# NOT auto-simplified (never truncated); staff write the simple version. Timeout in seconds.
SIMPLIFY_MAX_CHARS=12000
SIMPLIFY_TIMEOUT=60
# Keyword rules live in app/data/vocabulary.json. Point this at your own copy to change them without code changes.
VOCAB_FILE=
